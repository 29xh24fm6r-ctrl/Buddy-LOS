# Public browser-safe values only. Never expose a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Use the Supabase secret key; never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
BUDDY_DOCUMENT_DOWNLOADS_ENABLED=false
BUDDY_DOCUMENT_UPLOADS_ENABLED=false
BUDDY_DOCUMENT_SCANNING_ENABLED=false
BUDDY_DOCUMENT_SCANNER_WEBHOOK_SECRET=
BUDDY_DOCUMENT_SCANNER_PROVIDER=
BUDDY_DOCUMENT_SCANNER_ENDPOINT=
BUDDY_DOCUMENT_SCANNER_API_KEY=
BUDDY_DOCUMENT_SCANNER_CALLBACK_URL=
BUDDY_DOCUMENT_CLEANUP_ENABLED=false
BUDDY_DOCUMENT_OPERATIONS_ENABLED=false
CRON_SECRET=

# All migrated capabilities remain off until their phase exit gates pass.
NEXT_PUBLIC_BUDDY_AUTH_ENABLED=false
NEXT_PUBLIC_BUDDY_READS_ENABLED=false
NEXT_PUBLIC_BUDDY_WRITES_ENABLED=false
NEXT_PUBLIC_BUDDY_DOCUMENTS_ENABLED=false
NEXT_PUBLIC_BUDDY_INTEGRATIONS_ENABLED=false
BUDDY_UNDERWRITER_RUNTIME_ENABLED=false
BUDDY_UNDERWRITER_DOCUMENT_INTELLIGENCE_ENDPOINT=
BUDDY_UNDERWRITER_DOCUMENT_INTELLIGENCE_API_KEY=
BUDDY_UNDERWRITER_DOCUMENT_INTELLIGENCE_PROVIDER=
# Server-only JSON for a dedicated Cloud Run invoker service account. Required for private *.run.app endpoints.
BUDDY_UNDERWRITER_GOOGLE_SERVICE_ACCOUNT_JSON=
